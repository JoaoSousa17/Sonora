{
  "name": "Album",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "artist_id": {
      "type": "string",
      "description": "ref Artist"
    },
    "artist_name": {
      "type": "string"
    },
    "cover_url": {
      "type": "string"
    },
    "release_year": {
      "type": "number"
    },
    "genre": {
      "type": "string"
    },
    "track_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "artist_id"
  ]
}