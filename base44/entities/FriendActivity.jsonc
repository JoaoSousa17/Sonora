{
  "name": "FriendActivity",
  "type": "object",
  "properties": {
    "song_id": {
      "type": "string"
    },
    "song_title": {
      "type": "string"
    },
    "artist_name": {
      "type": "string"
    },
    "cover_url": {
      "type": "string"
    },
    "is_playing": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "song_title"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}