{
  "name": "PodcastEpisode",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "podcast_id": {
      "type": "string",
      "description": "ref Podcast"
    },
    "podcast_title": {
      "type": "string"
    },
    "duration_seconds": {
      "type": "number",
      "default": 0
    },
    "audio_url": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "publish_date": {
      "type": "string",
      "format": "date"
    },
    "cover_url": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "podcast_id"
  ]
}